# Meta for Developers
APP_SECRET=                 # Meta App Settings → Basic → App Secret (uses HMAC-SHA256 for signed_request verification)
META_APP_ID=                # The Meta App ID — used for verifying signed_request aud field
META_VERIFY_TOKEN=          # Random string you create; Meta will echo this back during webhook handshake

# Optional
PORT=10000                  # Render exposes PORT automatically; override locally
LOG_LEVEL=info
